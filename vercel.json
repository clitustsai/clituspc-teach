{
  "version": 2,
  "outputDirectory": ".",
  "buildCommand": "echo done",
  "installCommand": "npm install",
  "framework": null,
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/maintenance.html", "dest": "/maintenance.html" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/(.*)", "status": 302, "headers": { "Location": "/maintenance.html" } }
  ]
}
